name: build-fkiab-fix

# 一键构建「修好购买闪退」的 FKIAB
# 用法：Actions -> build-fkiab-fix -> Run workflow -> 跑完在 Artifacts 下载

on:
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Set up JDK 17
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '17'

      - name: Prepare Android SDK
        run: |
          if ! command -v sdkmanager >/dev/null 2>&1; then
            for d in "$ANDROID_HOME/cmdline-tools/latest/bin" \
                     "$ANDROID_SDK_ROOT/cmdline-tools/latest/bin" \
                     /usr/local/lib/android/sdk/cmdline-tools/latest/bin; do
              [ -d "$d" ] && export PATH="$d:$PATH"
            done
          fi
          yes | sdkmanager --licenses > /dev/null 2>&1 || true
          sdkmanager "platforms;android-37" > /dev/null 2>&1 || \
            sdkmanager "platforms;android-36" > /dev/null 2>&1 || true
          sdkmanager --list_installed 2>/dev/null | head -20 || true

      - name: Reuse native lib and frida scripts from official release
        run: |
          curl -sL -o base.apk \
            "https://github.com/Xposed-Modules-Repo/com.fuck.iab/releases/download/41-1.6.7/app-arm64-v8a-release.apk"
          ls -la base.apk
          unzip -o base.apk "lib/arm64-v8a/libnativehook.so" -d tmp
          mkdir -p app/src/main/jniLibs/arm64-v8a
          cp tmp/lib/arm64-v8a/libnativehook.so app/src/main/jniLibs/arm64-v8a/
          unzip -o base.apk "assets/scripts/*" -d tmp
          mkdir -p app/src/main/assets/scripts
          cp tmp/assets/scripts/*.js app/src/main/assets/scripts/ 2>/dev/null || true
          ls app/src/main/assets/scripts/ | head

      - name: Apply fix
        run: |
          echo '' | base64 -d > /tmp/fkiab_patch.py
          python3 /tmp/fkiab_patch.py
          echo "--- 关键的 7 号分支 ---"
          grep -n "getBuyIntentExtraParams" app/src/main/java/com/fuck/iab/FakeBinder.kt || true

      - name: Build APK
        run: ./gradlew assembleDebug --no-daemon --stacktrace

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: fkiab-fix-apk
          path: app/build/outputs/apk/debug/*.apk
          if-no-files-found: error
